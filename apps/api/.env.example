NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://wifi:wifi@localhost:5432/yurian_wifi
DATABASE_POOL_MAX=10
DATABASE_POOL_MAX_USES=0
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Secret used to sign short-lived Mini App launch contexts. Use a unique 32+ character random value.
JASLYN_MINI_APP_SECRET=

DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=require

# Per-router network management credentials use AES-256-GCM with versioned key IDs.
# Legacy deployments can keep this single 64-hex key until a planned rotation.
JASLYN_NETWORK_CREDENTIAL_KEY=
# For rotation, configure every old key plus the new key: id:64-hex,id:64-hex.
# Keep old keys until POST /routers/maintenance/rotate-credentials completes successfully.
JASLYN_NETWORK_CREDENTIAL_KEYRING=
# Must match one id in the keyring; new writes and rotations use this key.
JASLYN_NETWORK_CREDENTIAL_ACTIVE_KEY_ID=
JASLYN_NETWORK_API_TIMEOUT_MS=5000
# Keep false in production. HTTP network-device APIs are only acceptable for isolated testing.
JASLYN_NETWORK_ALLOW_HTTP=false

# Automatic billing/network reconciliation. The worker uses a PostgreSQL advisory lock so only one
# application instance performs a reconciliation cycle at a time.
JASLYN_RECONCILIATION_INTERVAL_MS=60000
JASLYN_STALE_SESSION_MINUTES=30

# Cisco Meraki native enforcement uses managed group policies created by JASLYN NET.
JASLYN_MERAKI_API_KEY=

# MikroTik RouterOS REST API fallback credentials for legacy routers without per-router credentials.
JASLYN_ROUTER_API_USERNAME=
JASLYN_ROUTER_API_PASSWORD=
JASLYN_ROUTER_API_TIMEOUT_MS=5000
# Keep false in production. HTTP RouterOS REST is only acceptable for isolated testing.
JASLYN_ROUTER_API_ALLOW_HTTP=false

# AI planning provider. Supported: deterministic, anthropic, llamafile.
# Set to llamafile for local/offline inference through the llamafile OpenAI-compatible API.
JASLYN_AI_PROVIDER=deterministic
JASLYN_AI_API_KEY=
JASLYN_AI_MODEL=claude-sonnet-4-5
JASLYN_AI_ENDPOINT=https://api.anthropic.com/v1/messages

# Local llamafile runtime. Keep the endpoint on a private network; do not expose it directly to the public Internet.
JASLYN_LLAMAFILE_ENDPOINT=http://127.0.0.1:8080/v1
JASLYN_LLAMAFILE_MODEL=LLaMA_CPP
JASLYN_LLAMAFILE_API_KEY=
JASLYN_LLAMAFILE_TIMEOUT_MS=15000

# Optional provider-neutral AI command layer. Anthropic is supported when selected; otherwise AI never fabricates answers.

# Tenant secrets vault encryption. Generate each 32-byte key with: openssl rand -hex 32.
# Keep old keys in the keyring until ciphertext rotation is verified. Never commit actual keys.
JASLYN_SECRET_VAULT_KEYRING=
JASLYN_SECRET_VAULT_ACTIVE_KEY_ID=

# Optional exact hostnames permitted to resolve privately for self-hosted synthetic checks.
SYNTHETIC_ALLOWED_PRIVATE_HOSTS=

# Encrypted router credential keyring. Entries are comma-separated key-id:64-hex-key pairs.
# Keep old keys until router credential rotation is verified; never commit real keys.
JASLYN_NETWORK_CREDENTIAL_KEYRING=
JASLYN_NETWORK_CREDENTIAL_ACTIVE_KEY_ID=
# Optional legacy single key (32-byte hex); prefer the keyring for planned rotation.
JASLYN_NETWORK_CREDENTIAL_KEY=
