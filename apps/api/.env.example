NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://wifi:wifi@localhost:5432/yurian_wifi
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=require

# Per-router network management credentials are encrypted at rest with AES-256-GCM.
# Set this to exactly 64 hexadecimal characters and store it in a secret manager in production.
JASLYN_NETWORK_CREDENTIAL_KEY=
JASLYN_NETWORK_API_TIMEOUT_MS=5000
# Keep false in production. HTTP network-device APIs are only acceptable for isolated testing.
JASLYN_NETWORK_ALLOW_HTTP=false

# Cisco Meraki native enforcement fallback credentials/configuration.
# Prefer per-router encrypted credentials and capabilities.merakiGroupPolicyId in production.
JASLYN_MERAKI_API_KEY=
JASLYN_MERAKI_GROUP_POLICY_ID=

# MikroTik RouterOS REST API fallback credentials for legacy routers without per-router credentials.
JASLYN_ROUTER_API_USERNAME=
JASLYN_ROUTER_API_PASSWORD=
JASLYN_ROUTER_API_TIMEOUT_MS=5000
# Keep false in production. HTTP RouterOS REST is only acceptable for isolated testing.
JASLYN_ROUTER_API_ALLOW_HTTP=false
