NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://wifi:wifi@localhost:5432/yurian_wifi
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

DATABASE_HOST=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# MikroTik RouterOS REST API credentials for the dedicated JASLYN NET service account.
JASLYN_ROUTER_API_USERNAME=
JASLYN_ROUTER_API_PASSWORD=
JASLYN_ROUTER_API_TIMEOUT_MS=5000
# Keep false in production. HTTP RouterOS REST is only acceptable for isolated testing.
JASLYN_ROUTER_API_ALLOW_HTTP=false
