{
  "name": "@jaslyn-net/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "node dist/database/migrate.js",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "benchmark": "pnpm build && node benchmarks/traffic.benchmark.cjs",
    "migrate:bundle": "pnpm build && node dist/database/bundle-migrations.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.11",
    "@nestjs/schematics": "^11.0.6",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.5",
    "@vercel/node": "^5.3.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
