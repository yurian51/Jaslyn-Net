{
  "name": "jaslyn-net",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @jaslyn-net/api --filter @jaslyn-net/web dev",
    "build": "pnpm --filter @jaslyn-net/api build && pnpm --filter @jaslyn-net/web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "sh -c 'pnpm --filter @jaslyn-net/api start & exec pnpm --filter @jaslyn-net/web start'"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
