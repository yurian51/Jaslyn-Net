# JASLYN NET local development configuration
# Never commit real credentials. Copy this file to .env locally.

POSTGRES_DB=yurian_wifi
POSTGRES_USER=wifi
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
DATABASE_URL=postgresql://wifi:CHANGE_ME_LOCALLY@localhost:5432/yurian_wifi

REDIS_URL=redis://localhost:6379

# Application secrets must be long, random values kept outside Git.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Public HTTPS URL used in customer activation SMS links.
CUSTOMER_PORTAL_PUBLIC_URL=https://your-customer-portal.example.com

# SMS stays disabled until a controlled production rollout is approved.
SMS_ENABLED=false
SMS_ALLOW_LEGACY_GLOBAL_PROVIDER=false
# Generate 32 random bytes; store the 64-character hex value in the deployment secret manager.
JASLYN_SMS_CREDENTIAL_ENCRYPTION_KEY=
# Exact custom provider hostnames approved by the system operator (comma-separated; no scheme or path).
SMS_CUSTOM_ALLOWED_HOSTS=

# Tenant secret vault keyring; each value is a 32-byte hex key. Keep old keys through rotation.
JASLYN_SECRET_VAULT_KEYRING=
JASLYN_SECRET_VAULT_ACTIVE_KEY_ID=
# Encrypted router credential keyring, comma-separated id:64-hex-key entries.
JASLYN_NETWORK_CREDENTIAL_KEYRING=
JASLYN_NETWORK_CREDENTIAL_ACTIVE_KEY_ID=
# Exact reviewed private hosts allowed for synthetic checks; leave empty by default.
SYNTHETIC_ALLOWED_PRIVATE_HOSTS=

# Automation fabric (see docs/AUTOMATION-FABRIC.md)
AUTOMATION_ENGINE_ENABLED=true
# Destructive automation (e.g. TERMINATE_SESSION) is OFF unless explicitly enabled.
AUTOMATION_DESTRUCTIVE_ACTIONS_ENABLED=false
AUTOMATION_DESTRUCTIVE_MAX_PER_HOUR=30
AUTOMATION_TENANT_MAX_INFLIGHT=10
AUTOMATION_APPROVAL_TTL_HOURS=24
AUTOMATION_RETENTION_DAYS=30
