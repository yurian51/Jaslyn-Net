# JASLYN NET local development configuration
# Never commit real credentials. Copy this file to .env locally.

POSTGRES_DB=yurian_wifi
POSTGRES_USER=wifi
POSTGRES_PASSWORD=CHANGE_ME_LOCALLY
DATABASE_URL=postgresql://wifi:CHANGE_ME_LOCALLY@localhost:5432/yurian_wifi

REDIS_URL=redis://localhost:6379

# Application secrets must be long, random values kept outside Git.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Secret vault keyring: JSON object of key IDs to 64-character hex (32-byte) keys.
# Generate keys with: openssl rand -hex 32. Keep old keys until all ciphertexts are rotated.
# Never use these placeholders as production secrets.
JASLYN_SECRET_VAULT_KEYRING=
JASLYN_SECRET_VAULT_ACTIVE_KEY_ID=

# Optional exact hostnames allowed to resolve to private IPs for self-hosted synthetic checks.
# Only add reviewed internal hosts; all other monitor targets reject private/reserved addresses.
SYNTHETIC_ALLOWED_PRIVATE_HOSTS=

# Encrypted router credential keyring. Entries use the format key-id:64-hex-key.
# Keep old keys until router credential rotation is verified; never commit real keys.
JASLYN_NETWORK_CREDENTIAL_KEYRING=
JASLYN_NETWORK_CREDENTIAL_ACTIVE_KEY_ID=
# Optional legacy single key (32-byte hex); prefer the keyring for planned rotation.
JASLYN_NETWORK_CREDENTIAL_KEY=
